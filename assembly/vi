name: LogKlerk CI

on:
  push:
    branches: [ main ]
  pull_request:

jobs:
  test-assembly:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: assembly
    steps:
      - uses: actions/checkout@v4
      - name: Install build & inspect tools
        run: sudo apt-get update && sudo apt-get install -y binutils python3
      - name: Assemble & Link
        run: |
          as --64 -g lk.s -o lk.o
          ld -z noexecstack -z relro -z now -o lk lk.o
      - name: Run Assembly Fuzz & Security Tests
        run: ./tests/test_assembly.sh ./lk

  test-rust:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: rust
    steps:
      - uses: actions/checkout@v4
      - name: Build & Run Cargo Tests
        run: |
          cargo build --release
          cargo test

  test-shell:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: sh
    steps:
      - uses: actions/checkout@v4
      - name: Install POSIX dash & shellcheck
        run: sudo apt-get update && sudo apt-get install -y dash shellcheck
      - name: Lint & Test POSIX Compliance
        run: |
          shellcheck -s sh lk.sh
          dash -c '. ./lk.sh && lk "test entry"'

